#!/bin/sh
# Offer to cut a release every time you push main.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Skip for a single push:
#   CL_NO_RELEASE=1 git push
#
# Picking a bump creates the tag and pushes it, which is what fires
# .github/workflows/release.yml. Pushing the tag also pushes the commit's
# objects, so a release is never left pointing at something the remote lacks.
set -eu

# --- version bump math (self-tested below: `.githooks/pre-push --self-test`) ---

# bump <version> <major|minor|patch> -> next version, no leading v
bump() {
    v="${1#v}"
    v="${v%%[-+]*}" # drop any -rc1 / +build suffix

    major="${v%%.*}"
    rest="${v#*.}"
    [ "$rest" = "$v" ] && rest="0.0"
    minor="${rest%%.*}"
    patch="${rest#*.}"
    [ "$patch" = "$rest" ] && patch="0"
    patch="${patch%%.*}"

    # Anything non-numeric becomes 0 rather than breaking arithmetic.
    case "$major" in *[!0-9]* | '') major=0 ;; esac
    case "$minor" in *[!0-9]* | '') minor=0 ;; esac
    case "$patch" in *[!0-9]* | '') patch=0 ;; esac

    case "$2" in
        major) printf '%s.0.0' "$((major + 1))" ;;
        minor) printf '%s.%s.0' "$major" "$((minor + 1))" ;;
        patch) printf '%s.%s.%s' "$major" "$minor" "$((patch + 1))" ;;
        *) return 1 ;;
    esac
}

if [ "${1:-}" = "--self-test" ]; then
    fail=0
    check() {
        got="$(bump "$1" "$2")"
        if [ "$got" != "$3" ]; then
            echo "FAIL: bump $1 $2 -> $got (want $3)" >&2
            fail=1
        fi
    }
    check 1.2.3 patch 1.2.4
    check 1.2.3 minor 1.3.0
    check 1.2.3 major 2.0.0
    check v1.2.3 patch 1.2.4
    check v0.0.0 patch 0.0.1
    check 1.9.9 minor 1.10.0
    check 0.1.0 major 1.0.0
    check 1.2.3-rc1 patch 1.2.4
    check 2.0 patch 2.0.1
    check 3 minor 3.1.0
    check garbage patch 0.0.1
    [ "$fail" = 0 ] && echo "pre-push: all bump cases pass"
    exit "$fail"
fi

# --- hook ---

# This hook pushes a tag, which fires pre-push again. Break the loop.
[ -n "${CL_HOOK_SKIP:-}" ] && exit 0
[ -n "${CL_NO_RELEASE:-}" ] && exit 0

# stdin is the ref list, so prompt on the controlling terminal instead. No
# terminal (CI, IDE push, scripts) means no prompt — just let the push through.
# The probe runs in a subshell: a failed redirect on `exec` would kill this
# script outright, and a non-zero exit here rejects the user's push.
(: </dev/tty) 2>/dev/null || exit 0
exec 3</dev/tty

# Match on the *remote* ref, not the local one: `git push origin HEAD:main`
# reports a local ref of "HEAD", so only the remote side reliably says where
# this is landing.
sha=""
branch=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main | refs/heads/master)
            branch="${remote_ref#refs/heads/}"
            sha="$local_sha"
            ;;
        refs/tags/*) exit 0 ;; # already pushing a tag
    esac
done

[ -n "$sha" ] || exit 0
# All-zero sha means the branch is being deleted.
case "$sha" in *[!0]*) ;; *) exit 0 ;; esac

latest="$(git tag -l 'v*' --sort=-v:refname | head -n1)"
[ -n "$latest" ] || latest="v0.0.0"

next_patch="v$(bump "$latest" patch)"
next_minor="v$(bump "$latest" minor)"
next_major="v$(bump "$latest" major)"

{
    printf '\n  \033[36m🧪 Chloride\033[0m \033[2m— pushing %s\033[0m\n' "$branch"
    printf '  \033[2mlatest release:\033[0m %s\n\n' "$latest"
    printf '  Cut a release?\n'
    printf '    \033[1mp\033[0m  patch  \033[2m→\033[0m %s\n' "$next_patch"
    printf '    \033[1mm\033[0m  minor  \033[2m→\033[0m %s\n' "$next_minor"
    printf '    \033[1mM\033[0m  major  \033[2m→\033[0m %s\n' "$next_major"
    printf '    \033[1mn\033[0m  no release, just push \033[2m(default)\033[0m\n\n'
    printf '  choice [n]: '
} >&2

read -r choice <&3 || choice=n

case "$choice" in
    p | patch) tag="$next_patch" ;;
    m | minor) tag="$next_minor" ;;
    M | major) tag="$next_major" ;;
    *)
        printf '  \033[2m→ no release\033[0m\n\n' >&2
        exit 0
        ;;
esac

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1; then
    printf '  \033[31merror:\033[0m tag %s already exists locally\n\n' "$tag" >&2
    exit 1
fi

git tag -a "$tag" -m "$tag" "$sha"

if ! CL_HOOK_SKIP=1 git push origin "$tag" >&2; then
    git tag -d "$tag" >/dev/null 2>&1 || true
    printf '  \033[31merror:\033[0m could not push %s — tag removed, push aborted\n\n' "$tag" >&2
    exit 1
fi

{
    printf '\n  \033[32m✔\033[0m released \033[1m%s\033[0m\n' "$tag"
    printf '  \033[2mbuilding on GitHub Actions:\033[0m\n'
    printf '  https://github.com/ayushChauhan9389/chloride/actions/workflows/release.yml\n\n'
} >&2
